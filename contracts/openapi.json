    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "description": "存活探针：不查库、不查机器人，给 docker/nginx 用。",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/deep": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health Deep",
        "description": "深探针：链路是否在线、后台循环是否活着、事件循环有没有卡。\n\n注意 online 是“平台到机器人”的链路状态，不是 /system/is_online（那是机器人能不能上互联网）。",
        "operationId": "health_deep_api_v1_health_deep_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Deep Api V1 Health Deep Get"
                }
              }
            }
          }
        }
      }
    },
