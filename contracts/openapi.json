    "/api/v1/robots/{robot_id}/nav-points": {
      "get": {
        "tags": [
          "robots"
        ],
        "summary": "Nav Points",
        "description": "点位：服务端解析一次，前端不再重复实现解析器。\n\n同时保留 path_data 原文——写回时未修改的行要原样保留，不能整文件重排。",
        "operationId": "nav_points_api_v1_robots__robot_id__nav_points_get",
        "parameters": [
          {
            "name": "robot_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Robot Id"
            }
          },
          {
            "name": "map_name",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Map Name"
            }
          },
          {
            "name": "path_name",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Path Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
