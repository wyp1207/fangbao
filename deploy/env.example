# 复制成 deploy/env 后改；不要提交真实密码
# ---------------- 安全 ----------------
# 随机 32 字节以上，用 openssl rand -hex 32 生成
JC_SECRET_KEY=please-change-this-to-a-random-32-byte-string
JC_DB_PASSWORD=changeme
JC_DB_ROOT_PASSWORD=changeme-too

# ---------------- 机器人 ----------------
# mock = 不连真机（演示/联调前）；http = 连 JCROB
JC_ROBOT_MODE=mock
JC_JCROB_BASE_URL=http://192.168.1.100:3546
JC_JCROB_USERNAME=admin
JC_JCROB_PASSWORD=admin

# ---------------- 视频 ----------------
# 后端访问 go2rtc 的地址（容器 → 宿主）
JC_GO2RTC_BASE=http://host.docker.internal:1984
# 浏览器访问 go2rtc 的前缀；走 nginx 同源反代，一般不用改
JC_GO2RTC_PUBLIC_BASE=/go2rtc

# ---------------- 录像 ----------------
# 与 compose 的 /data/jcrob-platform/recordings 挂载对应
JC_RECORDING_ENABLED=true
JC_RECORD_KEEP_DAYS=30
JC_RECORD_MAX_GB=800
JC_RECORD_MIN_FREE_GB=5

# ---------------- 其他 ----------------
JC_BOOTSTRAP_ADMIN=admin
JC_BOOTSTRAP_PASSWORD=please-change-on-first-login
JC_LOG_LEVEL=INFO
