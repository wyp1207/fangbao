# 复制成 .env 后按现场修改；不要提交真实凭据
JC_ENV=dev
JC_SECRET_KEY=change-me-in-production-please-32-bytes-min
JC_DB_URL=sqlite:///./data/app.db

# 机器人连接（dev 用 mock，不连真机）
JC_ROBOT_MODE=mock
JC_JCROB_BASE_URL=http://127.0.0.1:3546
JC_JCROB_WS_URL=ws://127.0.0.1:3547
JC_JCROB_USERNAME=admin
JC_JCROB_PASSWORD=admin
JC_JCROB_TOKEN=
JC_JCROB_HTTP_TIMEOUT=3.0
JC_JCROB_POLL_INTERVAL=1.0

# 首次启动创建的账号
JC_BOOTSTRAP_ADMIN=admin
JC_BOOTSTRAP_PASSWORD=admin123

JC_LOG_LEVEL=INFO
JC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
